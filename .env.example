# Copie para .env e troque os valores: cp .env.example .env
# O .env real NÃO vai para o Git (está no .gitignore)

# Banco Oracle
# Senha de SYS/SYSTEM (administração do banco)
ORACLE_PASSWORD=troque-esta-senha-admin
# Schema da aplicação: dono das tabelas do script de BD e usuário que a API usa
APP_USER=granaamiga
APP_USER_PASSWORD=troque-esta-senha-app

# API
# Segredo para assinar os tokens JWT (mínimo 32 caracteres; gere com: openssl rand -base64 48)
APP_JWT_SECRET=troque-este-segredo-com-pelo-menos-32-caracteres
# Administrador: o script de BD cria o admin com este telefone; a API grava esta senha (BCrypt) na subida
APP_BOOTSTRAP_ADMIN_PHONE=11900000010
APP_BOOTSTRAP_ADMIN_PASSWORD=troque-esta-senha-do-admin

# Porta publicada da API na VM (host -> container 8080)
APP_PORT=8080
